# Core storage and upload configuration
# KNOWBRIDGE_DATA_DIR=./data
# KNOWBRIDGE_MAX_UPLOAD_BYTES=10485760

# LLM provider selection: auto | openai | ollama | none
# auto prefers OpenAI when a key is set, otherwise Ollama only if enabled.
KNOWBRIDGE_LLM_PROVIDER=auto

# Hosted provider (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local Ollama provider (optional). Enable only after installing Ollama.
KNOWBRIDGE_OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional vector database foundation (not used by lexical retrieval yet)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Optional observability foundation (not yet tracing requests)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Frontend
VITE_API_URL=http://localhost:8000
